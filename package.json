    "astro": "astro",
    "test": "node --test scripts/*.test.mjs src/utils/*.test.mjs .github/scripts/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.1.7",
    "katex": "^0.16.45",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "sharp": "0.34.5"
  }
}
