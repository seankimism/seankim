{
  "name": "academic-portfolio-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "watermark:figures": "node scripts/watermark-model-figures.mjs",
    "predev": "npm run watermark:figures",
    "prebuild": "npm run watermark:figures",
    "dev": "astro dev",
    "build": "astro build && node scripts/check-xdr-results.mjs dist/xdr2000 && node scripts/check-control-results.mjs dist/thermal-control && node scripts/check-bench-results.mjs dist/bench-heating && node scripts/check-project-redirect.mjs dist",
