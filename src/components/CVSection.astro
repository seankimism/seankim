---
import type { CollectionEntry } from "astro:content";
import { groupByInstitution } from "../utils/cv-entries.mjs";

type Props = CollectionEntry<"cv">["data"]["sections"][number];

const { id, title, entries } = Astro.props;
---

<section class="section" aria-labelledby={id}>
  <h2 id={id}>{title}</h2>
  {groupByInstitution(entries).map(group => (
    <article class="cv-entry">
      {group.institution && <p class="cv-institution">{group.institution}</p>}
      {group.entries.map(entry => (
        <div class="cv-item">
          <div class="entry-header">
            <h3>{entry.title}</h3>
            {entry.period && <span class="entry-period">{entry.period}</span>}
          </div>
          {entry.description && <p class="entry-description">{entry.description}</p>}
          {entry.thesis && <p class="entry-thesis">Dissertation: <em>{entry.thesis}</em></p>}
          {entry.links && entry.links.length > 0 && (
            <p class="entry-links">
              {entry.links.map((link, index) => (
                <Fragment>
                  {index > 0 && <span aria-hidden="true"> · </span>}
                  <a href={link.url}>{link.label}</a>
                </Fragment>
              ))}
            </p>
          )}
        </div>
      ))}
    </article>
  ))}
</section>
