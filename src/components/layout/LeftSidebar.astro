---
import { SOCIALS, SOCIAL_ICONS } from "../../config";
import { getEntry } from "astro:content";
import Icon from "../ui/Icon.astro";
import { withBase } from "../../utils/paths";
const bio = (await getEntry("bio", "bio"))!.data;
---
<aside class="sidebar profile-sidebar" aria-label="Profile and contact">
  <a class="profile-avatar" href={withBase('/')} aria-label="Sean Kim home">
    {bio.avatar ? (
      <img class="profile-photo" src={withBase(bio.avatar)} alt={`Portrait of ${bio.name}`} width="116" height="116" decoding="async" />
    ) : (
      <span class="profile-monogram">SK<span>.</span></span>
    )}
  </a>
  <div class="profile-content">
    <a class="sidebar-name profile-name" href={withBase('/')}>Sean Kim</a>
    {(bio.role || bio.institution) && (
      <p class="profile-role">
        {bio.role}
        {bio.role && bio.institution && <br />}
        {bio.institution && <span>{bio.institution}</span>}
      </p>
    )}
    <p class="sidebar-bio">{bio.shortBio}</p>
    {bio.location && <p class="profile-location"><Icon name="Institution" size={16} />{bio.location}</p>}
    <div class="profile-socials">
      {SOCIALS.filter(s => s.isActive).map(s => <a class="social-link" href={s.href} aria-label={s.linkTitle} title={s.linkTitle} target={s.name === 'Mail' ? undefined : '_blank'} rel="noopener noreferrer"><Icon name={SOCIAL_ICONS[s.name]} size={21} /></a>)}
    </div>
    <a class="resume-link" href={withBase('/files/Sean_Kim_Resume.pdf')} target="_blank" rel="noopener noreferrer"><Icon name="ExternalLink" size={16} /> Resume <span class="file-label">PDF</span></a>
  </div>
</aside>
