---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../utils/paths';
import { isPublished } from '../../utils/content';
const projects = (await getCollection('projects')).filter(isPublished).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title="Projects"><header class="page-header"><p class="eyebrow">Research & development</p><h1 class="page-title">Projects</h1><p class="page-subtitle">Selected work in bioprocess development, computational modeling, and tissue engineering.</p></header><div class="project-list">{projects.map(project => <article class="project-entry"><div class="project-meta"><span>{project.data.organization}</span><span>{project.data.period}</span></div><h2><a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a></h2><p>{project.data.description}</p><ul class="topic-list" aria-label="Project topics">{project.data.tags.map(tag => <li>{tag}</li>)}</ul><a class="read-more" href={withBase(`/projects/${project.id}/`)}>Read project <span aria-hidden="true">→</span></a></article>)}</div></BaseLayout>
