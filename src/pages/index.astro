---
import { getEntry, getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SOCIALS } from "../config";
import { withBase } from "../utils/paths";
const bio = (await getEntry('bio','bio'))!;
const { Content } = await render(bio);
const projects = (await getCollection('projects')).filter(p => p.data.featured).sort((a,b) => a.data.order-b.data.order);
const papers = (await getCollection('publications')).filter(p => p.data.featured).sort((a,b) => b.data.year-a.data.year);
const linkedIn = SOCIALS.find(link => link.name === 'LinkedIn' && link.isActive);
---
<BaseLayout title="About">
  <header class="page-header"><p class="eyebrow">Bioprocessing · Modeling · Biofabrication</p><h1 class="page-title">About me</h1></header>
  <div class="prose home-bio"><Content /></div>
  <section class="home-section" aria-labelledby="focus-heading"><h2 id="focus-heading" class="section-title">Research & engineering</h2><div class="focus-list">{bio.data.researchAreas.map((area,index) => <div class="focus-row"><span class="focus-number">0{index+1}</span><div><h3>{area.title}</h3><p>{area.description}</p></div></div>)}</div></section>
  <section class="home-section" aria-labelledby="work-heading"><div class="section-heading"><h2 id="work-heading" class="section-title">Selected work</h2><a href={withBase('/projects/')}>All projects <span aria-hidden="true">→</span></a></div><div class="home-projects">{projects.map(project => <article class="home-project"><p class="eyebrow">{project.data.organization}</p><h3><a href={withBase(`/projects/${project.id}/`)}>{project.data.title}</a></h3><p>{project.data.description}</p><a class="read-more" href={withBase(`/projects/${project.id}/`)}>Read project <span aria-hidden="true">→</span></a></article>)}</div></section>
  {papers.length > 0 && <section class="home-section" aria-labelledby="papers-heading"><div class="section-heading"><h2 id="papers-heading" class="section-title">Selected publications</h2><a href={withBase('/publications/')}>All publications <span aria-hidden="true">→</span></a></div>{papers.map(paper => <article class="home-paper"><span class="publication-year">{paper.data.year}</span><div><h3><a href={withBase(`/publications/${paper.id}/`)}>{paper.data.title}</a></h3><p>{paper.data.journal}</p></div></article>)}</section>}
  <section class="contact-section"><h2>Let's connect</h2><p>For conversations about bioprocess development, computational modeling, or tissue engineering, {linkedIn && <Fragment>connect with me on <a href={linkedIn.href} target="_blank" rel="noopener noreferrer">LinkedIn</a> or </Fragment>}email me at <a href="mailto:bk525@cornell.edu">bk525@cornell.edu</a>.</p></section>
</BaseLayout>
