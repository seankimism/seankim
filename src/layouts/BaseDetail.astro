---
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { SITE } from '../config';
import { withBase } from '../utils/paths';
interface Props { collection: 'projects' | 'publications'; id: string; }
const { collection, id } = Astro.props;
const entry = (await getEntry(collection,id))!;
const { Content } = await render(entry);
const data = entry.data;
const project = collection === 'projects';
const paper = 'author' in data ? data : null;
// Structured data: the page as a scholarly article or article, plus its breadcrumb trail.
const site = Astro.site || SITE.website;
const absolute = (path: string) => new URL(withBase(path), site).href;
const pageURL = absolute(`/${collection}/${id}/`);
const me = { '@type': 'Person', '@id': `${absolute('/')}#person`, name: 'Byumsu Sean Kim', url: absolute('/') };
const breadcrumb = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Home', item: absolute('/') },
  { '@type': 'ListItem', position: 2, name: project ? 'Projects' : 'Publications', item: absolute(`/${collection}/`) },
  { '@type': 'ListItem', position: 3, name: data.title, item: pageURL },
] };
const article = paper
  ? { '@context': 'https://schema.org', '@type': 'ScholarlyArticle', '@id': pageURL, headline: paper.title, url: pageURL, mainEntityOfPage: pageURL,
      author: paper.author.split(/,\s*/).map(name => name === 'Byumsu Kim' ? me : { '@type': 'Person', name }),
      datePublished: String(paper.year),
      isPartOf: { '@type': paper.category === 'chapter' ? 'Book' : 'Periodical', name: paper.journal },
      ...(paper.description && { description: paper.description }),
      ...(paper.doi && { identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: paper.doi } }),
      ...(paper.external_url && { sameAs: paper.external_url }),
      ...(paper.image && { image: absolute(paper.image) }) }
  : { '@context': 'https://schema.org', '@type': 'Article', '@id': pageURL, headline: data.title, description: data.description, url: pageURL, mainEntityOfPage: pageURL,
      author: me, ...(data.tags.length > 0 && { keywords: data.tags.join(', ') }),
      ...('organization' in data && { sourceOrganization: { '@type': 'Organization', name: data.organization } }) };
---
<BaseLayout title={data.title} description={data.description} ogType="article" ogImage={paper?.image} ogImageAlt={paper?.imageAlt} jsonLd={[article, breadcrumb]}>
  <a class="detail-back" href={withBase(`/${collection}/`)}>← All {collection}</a>
  <article><h1 class="detail-heading">{data.title}</h1>
  <div class="detail-meta">
    {project && 'organization' in data && <div class="project-meta"><span>{data.organization}</span><span>{data.period}</span></div>}
    {paper && <><p class="publication-authors">{paper.author}</p><p class="publication-venue">{paper.journal}{paper.citation ? ` · ${paper.citation}` : ''} · {paper.year}</p><span class="status">{paper.status || 'Published'}</span></>}
    {data.tags.length > 0 && <ul class="topic-list" aria-label="Topics">{data.tags.map(tag => <li>{tag}</li>)}</ul>}
  </div>
  {paper?.external_url && <div class="detail-links"><a class="download-button" href={paper.external_url} target="_blank" rel="noopener noreferrer">{paper.category === 'preprint' ? 'Read preprint' : 'Read publication'} ↗</a></div>}
  <div class="prose">
    {paper?.description && <p>{paper.description}</p>}
    {paper?.image && <figure class="xdr-figure"><a href={paper.external_url} target="_blank" rel="noopener noreferrer" aria-label="Open the publication"><img src={withBase(paper.image)} alt={paper.imageAlt ?? ''} width={paper.imageWidth} height={paper.imageHeight} loading="lazy" decoding="async" /></a></figure>}
    <Content />
  </div>
  {paper && <section class="detail-citation"><h2>Citation</h2><p>{paper.author} ({paper.year}). {paper.title}. {paper.journal}{paper.citation ? `, ${paper.citation}` : ''}.{paper.doi && <> <a href={paper.external_url}>doi:{paper.doi}</a></>}</p></section>}
  </article>
</BaseLayout>

<script>
  // Size local result exports to their content, including their mobile controls.
  // Observing the inner main avoids a feedback loop with the iframe's own height.
  function connectResultFrames() {
    document.querySelectorAll<HTMLIFrameElement>('iframe[data-content-height]').forEach(frame => {
      if (frame.dataset.connected) return;
      frame.dataset.connected = 'true';
      let observer: ResizeObserver | undefined;
      const connect = () => {
        observer?.disconnect();
        if (new URL(frame.src).origin !== window.location.origin) return;
        const doc = frame.contentDocument;
        const main = doc?.querySelector('main');
        if (!doc?.body || !main || !frame.contentWindow) return;
        const resize = () => {
          const bodyStyle = frame.contentWindow!.getComputedStyle(doc.body);
          const padding = parseFloat(bodyStyle.paddingTop) + parseFloat(bodyStyle.paddingBottom);
          frame.style.height = `${Math.ceil(main.getBoundingClientRect().height + padding + 2)}px`;
        };
        observer = new ResizeObserver(resize);
        observer.observe(main);
        resize();
      };
      frame.addEventListener('load', connect);
      connect();
      document.addEventListener('astro:before-swap', () => {
        observer?.disconnect();
        frame.removeEventListener('load', connect);
        delete frame.dataset.connected;
      }, { once: true });
    });
  }
  document.addEventListener('astro:page-load', connectResultFrames);
  // Direct page loads must not depend on an Astro navigation event.
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', connectResultFrames, { once: true });
  }
  connectResultFrames();
</script>
