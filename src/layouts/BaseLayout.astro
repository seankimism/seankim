---
import { ANALYTICS, SEO, SITE, THEME_CONFIG, THEMES } from "../config";
import { ClientRouter } from "astro:transitions";
import LeftSidebar from "../components/LeftSidebar.astro";
import RightMain from "../components/RightMain.astro";
import { withBase } from "../utils/paths";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/jetbrains-mono/400.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";
interface Props {
  title: string;
  /** Replaces the "{title} | {site}" pattern in <title> and social titles, e.g. on the home page. */
  fullTitle?: string;
  description?: string;
  /** Root-relative image for social cards; falls back to the site card. */
  ogImage?: string;
  ogImageAlt?: string;
  ogType?: "website" | "article";
  robots?: string;
  /** Additional schema.org objects rendered as JSON-LD after the Person block. */
  jsonLd?: Record<string, unknown>[];
}
const { title, fullTitle, description = SITE.desc, ogImage, ogImageAlt, ogType = 'website', robots = 'index, follow', jsonLd: extraJsonLd = [] } = Astro.props;
const pageTitle = fullTitle ?? `${title} | ${SITE.title}`;
const canonicalPath = Astro.url.pathname.replace(/\/404\/?$/, '/404.html');
const canonicalURL = new URL(canonicalPath, Astro.site || SITE.website);
const profileURL = new URL(withBase('/'), Astro.site || SITE.website);
const usesDefaultImage = !ogImage;
const imageURL = new URL(withBase(ogImage ?? SEO.image), Astro.site || SITE.website);
const imageAlt = ogImageAlt ?? SEO.imageAlt;
const light = THEMES[THEME_CONFIG.themeLight];
const dark = THEMES[THEME_CONFIG.themeDark];
const themeVars = Object.entries({ lightBg: light.background, lightFg: light.foreground, lightAccent: light.accent, lightMuted: light.muted, lightBorder: light.border, lightSurface: light.surface, darkBg: dark.background, darkFg: dark.foreground, darkAccent: dark.accent, darkMuted: dark.muted, darkBorder: dark.border, darkSurface: dark.surface }).map(([key,value]) => `--${key}:${value}`).join(';');
const person = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': `${profileURL.href}#person`,
  name: 'Byumsu Sean Kim', givenName: 'Byumsu', familyName: 'Kim', alternateName: ['Sean Kim', 'Byumsu Kim'],
  url: profileURL.href, image: new URL(withBase('/images/sean-kim.jpg'), Astro.site || SITE.website).href,
  jobTitle: SEO.jobTitle, description: SITE.desc, knowsAbout: SEO.knowsAbout,
  alumniOf: [{ '@type': 'CollegeOrUniversity', name: 'Cornell University' }, { '@type': 'CollegeOrUniversity', name: 'Purdue University' }],
  sameAs: SEO.sameAs,
};
const jsonLdBlocks = [person, ...extraJsonLd];
---
<!doctype html>
<html lang="en" style={themeVars}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={withBase(SITE.favicon)} />
    <link rel="canonical" href={canonicalURL} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="robots" content={robots} />
    {SEO.googleSiteVerification && <meta name="google-site-verification" content={SEO.googleSiteVerification} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    {usesDefaultImage && <meta property="og:image:width" content={String(SEO.imageWidth)} />}
    {usesDefaultImage && <meta property="og:image:height" content={String(SEO.imageHeight)} />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {jsonLdBlocks.map(block => <script type="application/ld+json" set:html={JSON.stringify(block)} />)}
    {import.meta.env.PROD && ANALYTICS.umami?.websiteId && ANALYTICS.umami.src && (
      <script
        is:inline
        defer
        src={ANALYTICS.umami.src}
        data-website-id={ANALYTICS.umami.websiteId}
        data-domains={profileURL.hostname}
      ></script>
    )}
    <ClientRouter />
    <script is:inline>
      function applyPreferredTheme() {
        let theme;
        try { theme = localStorage.getItem('theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      }
      applyPreferredTheme();
      document.addEventListener('astro:after-swap', applyPreferredTheme);
    </script>
    <script>
      function connectThemeToggle() {
        const toggle = document.getElementById('theme-toggle');
        if (!toggle || toggle.dataset.connected) return;
        toggle.dataset.connected = 'true';
        const updateLabel = () => toggle.setAttribute('aria-label', `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} theme`);
        updateLabel();
        toggle.addEventListener('click', () => {
          const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch {}
          updateLabel();
        });
      }
      document.addEventListener('astro:page-load', connectThemeToggle);
    </script>
    <script>
      // Delegation survives Astro page swaps without reconnecting each player.
      document.addEventListener('click', (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest('.youtube-player__button');
        if (!(button instanceof HTMLButtonElement)) return;
        const player = button.closest<HTMLElement>('.youtube-player[data-youtube-id]');
        const videoId = player?.dataset.youtubeId;
        if (!player || !videoId || !/^[A-Za-z0-9_-]{11}$/.test(videoId)) return;
        const frame = document.createElement('iframe');
        frame.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
        frame.title = player.dataset.youtubeTitle || 'Bioreactor simulation';
        frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        frame.allowFullscreen = true;
        frame.referrerPolicy = 'strict-origin-when-cross-origin';
        frame.tabIndex = 0;
        player.replaceChildren(frame);
        frame.focus();
      });
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell"><LeftSidebar /><RightMain><slot /></RightMain></div>
  </body>
</html>
